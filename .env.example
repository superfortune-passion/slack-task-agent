# =============================================================================
# Slack Task Agent — Environment variables
# =============================================================================
# Copy to .env.local for local dev:
#   copy .env.example .env.local
#
# On Vercel: Project → Settings → Environment Variables
#
# NO KEYS REQUIRED — app uses mock/demo analysis automatically.
# =============================================================================

# Optional: force AI provider (openai | gemini | mock)
# AI_PROVIDER=mock

# --- OpenAI (optional) ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (optional) ---
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-1.5-flash

# --- Site URL (optional, for Open Graph metadata) ---
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
